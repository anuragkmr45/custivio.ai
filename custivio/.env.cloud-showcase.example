NODE_ENV=production
APP_NAME=custivio
APP_BASE_URL=https://api.showcase.example.com
API_HOST=0.0.0.0
API_PORT=3000
CORS_ALLOWED_ORIGINS=https://app.showcase.example.com,https://custivio-showcase.netlify.app,https://custivio-showcase.vercel.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
DATABASE_URL=postgresql://custivio:change-me@postgres:5432/custivio
VALKEY_HOST=valkey
VALKEY_PORT=6379
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=custivio
OTEL_SERVICE_NAME=custivio-api
METRICS_PREFIX=custivio_
LOG_LEVEL=info
UAT_ADMIN_EMAIL=admin@custivio.local
UAT_MANAGER_EMAIL=manager@custivio.local
UAT_STORE_EMAIL=store@custivio.local
UAT_AUDITOR_EMAIL=auditor@custivio.local
UAT_SEED_PASSWORD=change-this-password
