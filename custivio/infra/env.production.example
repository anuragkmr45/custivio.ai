NODE_ENV=production
APP_ENV_FILE=./env.production.example
APP_IMAGE_TAG=local
APP_NAME=custivio
APP_BASE_URL=https://custivio.example.local
API_HOST=0.0.0.0
API_PORT=3000
CORS_ALLOWED_ORIGINS=https://frontend.example.local
COOKIE_SECURE=true

DATABASE_URL=postgresql://custivio:REPLACE_ME@postgres:5432/custivio
POSTGRES_DB=custivio
POSTGRES_USER=custivio
POSTGRES_PASSWORD=REPLACE_ME

VALKEY_HOST=valkey
VALKEY_PORT=6379

MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET=custivio

HEALTHCHECK_TIMEOUT_MS=2000
OTEL_SERVICE_NAME=custivio-api
LOG_LEVEL=info
METRICS_PREFIX=custivio_
DEV_SEED_TENANT_NAME=Default Tenant

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
