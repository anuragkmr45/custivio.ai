APP_ENV_FILE=./env.production.validation.example
APP_IMAGE_TAG=validation
NODE_ENV=production
APP_NAME=custivio
APP_BASE_URL=https://custivio.validation.local
API_HOST=0.0.0.0
API_PORT=3000
CORS_ALLOWED_ORIGINS=https://custivio-web.validation.local
COOKIE_SECURE=true

DATABASE_URL=postgresql://custivio:validation_postgres_password@postgres:5432/custivio
POSTGRES_DB=custivio
POSTGRES_USER=custivio
POSTGRES_PASSWORD=validation_postgres_password

VALKEY_HOST=valkey
VALKEY_PORT=6379

MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=validation_minio_access_key
MINIO_SECRET_KEY=validation_minio_secret_key
MINIO_BUCKET=custivio

HEALTHCHECK_TIMEOUT_MS=2000
OTEL_SERVICE_NAME=custivio-api
LOG_LEVEL=info
METRICS_PREFIX=custivio_
DEV_SEED_TENANT_NAME=Default Tenant

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=validation_grafana_password
