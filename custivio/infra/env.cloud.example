NODE_ENV=production
APP_NAME=custivio-cloud-demo
APP_BASE_URL=https://custivio-api.onrender.com
API_HOST=0.0.0.0
API_PORT=10000
CORS_ALLOWED_ORIGINS=https://custivio-web.example.workers.dev
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Supabase PostgreSQL session-pooler URL (port 5432), used only through PostgreSQL/Drizzle.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=4
DATABASE_SSL=true

# Upstash native Redis endpoint. The token shown by Upstash is the password.
VALKEY_HOST=REPLACE_ME.upstash.io
VALKEY_PORT=6379
VALKEY_USERNAME=default
VALKEY_PASSWORD=REPLACE_ME
VALKEY_USE_TLS=true

# Supabase Storage S3 endpoint and server-side S3 access keys.
MINIO_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
MINIO_REGION=REPLACE_ME
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET=custivio

# Render Free has no free background-worker service. Run both queue consumers in the API process.
RUN_WORKER_IN_API=true
WORKER_INTERVAL_MS=30000

HEALTHCHECK_TIMEOUT_MS=5000
OTEL_SERVICE_NAME=custivio-api-cloud-demo
LOG_LEVEL=info
METRICS_PREFIX=custivio_

BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=Custivio Demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Demo Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
