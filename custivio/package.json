{
  "name": "custivio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @custivio/api dev",
    "dev:api": "pnpm --filter @custivio/api dev",
    "build": "pnpm --filter @custivio/api build",
    "build:api": "pnpm --filter @custivio/api build",
    "start": "pnpm --filter @custivio/api start",
    "start:api": "pnpm --filter @custivio/api start",
    "test:api": "pnpm --filter @custivio/api test",
    "worker": "pnpm --filter @custivio/api worker",
    "worker:dev": "pnpm --filter @custivio/api worker:dev",
    "test:workers": "pnpm --filter @custivio/api test:workers",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @custivio/db db:generate",
    "db:migrate": "pnpm --filter @custivio/db db:migrate",
    "db:seed": "pnpm --filter @custivio/db db:seed",
    "db:seed:uat": "pnpm --filter @custivio/db db:seed:uat",
    "db:bootstrap-admin": "pnpm --filter @custivio/db db:bootstrap-admin",
    "docker:dev": "docker compose -f infra/docker-compose.dev.yml up -d",
    "docker:prod:config": "bash scripts/validate-prod-compose.sh",
    "backup:dev": "bash scripts/backup-dev.sh",
    "restore:dev": "bash scripts/restore-dev.sh",
    "smoke:api": "bash scripts/smoke-api.sh",
    "check:forbidden": "node scripts/check-forbidden-deps.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:forbidden"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "drizzle-kit": "latest",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "latest",
    "eslint-plugin-import": "latest",
    "globals": "latest",
    "prettier": "3.6.2",
    "tsx": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vitest": "4.0.8"
  }
}
