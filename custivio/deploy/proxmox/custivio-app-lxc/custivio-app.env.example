# Copy to /etc/custivio/custivio.env and set mode 0640.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3000
APP_BASE_URL=https://custivio.example.internal
CORS_ALLOWED_ORIGINS=https://custivio.example.internal
DATABASE_URL=postgresql://custivio_app:<CHANGE_ME_DB_PASSWORD>@<DATA_PRIVATE_IP>:5432/custivio
VALKEY_HOST=<DATA_PRIVATE_IP>
VALKEY_PORT=6379
VALKEY_PASSWORD=<CHANGE_ME_VALKEY_PASSWORD>
MINIO_ENDPOINT=http://<DATA_PRIVATE_IP>:9000
MINIO_ACCESS_KEY=<CHANGE_ME_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<CHANGE_ME_MINIO_SECRET_KEY>
MINIO_BUCKET=custivio
OTEL_SERVICE_NAME=custivio-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://<OBS_PRIVATE_IP>:4318
OTEL_RESOURCE_ATTRIBUTES=org=<ORG_SLUG>,software=custivio,environment=production,role=api
