server {
  listen 80;
  server_name custivio.example.internal;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name custivio.example.internal;

  ssl_certificate /etc/ssl/custivio/fullchain.pem;
  ssl_certificate_key /etc/ssl/custivio/privkey.pem;

  root /opt/custivio/current/frontend;
  index index.html;

  location /api/ {
    proxy_pass http://127.0.0.1:3000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    try_files $uri /index.html;
  }

  access_log /var/log/custivio/reverse-proxy/nginx-access.log;
  error_log /var/log/custivio/reverse-proxy/nginx-error.log;
}
