{
  "name": "@custivio/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:uat": "tsx src/seed-uat.ts",
    "db:seed:showcase": "tsx src/seed-showcase.ts",
    "db:bootstrap-admin": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@custivio/config": "workspace:*",
    "drizzle-orm": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/pg": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "5.9.3"
  }
}
