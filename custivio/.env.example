NODE_ENV=development
APP_NAME=custivio
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5177,http://127.0.0.1:5177
DATABASE_URL=postgresql://custivio:custivio_dev@localhost:5432/custivio
VALKEY_HOST=localhost
VALKEY_PORT=6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=custivio
HEALTHCHECK_TIMEOUT_MS=2000
OTEL_SERVICE_NAME=custivio-api
LOG_LEVEL=info
METRICS_PREFIX=custivio_
DEV_SEED_TENANT_NAME=Default Tenant
# Set these in .env before running `pnpm db:seed:uat`.
# UAT_ADMIN_EMAIL=<admin email>
# UAT_MANAGER_EMAIL=<manager email>
# UAT_STORE_EMAIL=<store email>
# UAT_TECHNICIAN_EMAIL=<technician email>
# UAT_APPROVER_EMAIL=<manager approver email>
# UAT_AUDITOR_EMAIL=<auditor email>
# UAT_VIEWER_EMAIL=<read only viewer email>
# UAT_SEED_PASSWORD=<local UAT password>

# Set these only when bootstrapping the first production/on-prem tenant admin.
# BOOTSTRAP_TENANT_SLUG=<tenant slug>
# BOOTSTRAP_TENANT_NAME=<tenant display name>
# BOOTSTRAP_ADMIN_EMAIL=<admin email>
# BOOTSTRAP_ADMIN_NAME=<admin display name>
# BOOTSTRAP_ADMIN_PASSWORD=<strong one-time admin password>
